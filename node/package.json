{
  "name": "habarico",
  "version": "7.3.0-beta.7",
  "description": "With this library you can connect to BE schemas and automatically or semi-automatically generate an admin dashboard.",
  "type": "module",
  "main": "lib/index.cjs",
  "module": "lib/index.esm.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "prebuild": "tsc --emitDeclarationOnly --noEmit false -p tsconfig.build.json",
    "build": "rollup -c",
    "watch:js": "rollup -c -w",
    "watch:types": "tsc --emitDeclarationOnly --watch -p tsconfig.build.json",
    "watch": "npm run prebuild && concurrently \"npm run watch:js\" \"npm run watch:types\"",
    "prettier": "prettier --write .",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --project=unit && npm run test:scripts",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:storybook": "vitest run --project=storybook",
    "test:all": "vitest run",
    "test:watch": "vitest --project=unit",
    "test:coverage": "vitest run --project=unit --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eluvia-com/habarico.git",
    "directory": "node"
  },
  "author": "Eluvia",
  "license": "MIT",
  "dependencies": {
    "@bicstone/ra-language-japanese": "^5.12.1",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource/barlow": "^5.2.8",
    "@iconify/react": "^6.0.2",
    "@mui/utils": "^7.0.0",
    "@tiptap/react": "^3.20.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jsep": "^1.4.0",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.17.21",
    "minimal-shared": "^1.1.5",
    "query-string": "^9.5.1",
    "ra-i18n-polyglot": "~5.14.5",
    "ra-input-rich-text": "^5.14.5",
    "ra-language-czech": "^5.7.0",
    "ra-language-english": "^5.14.5",
    "ra-language-french": "^5.14.7",
